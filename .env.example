# Local PGlite directory. Staging/production uses the Neon pooled PostgreSQL URL.
DATABASE_URL=pglite:./data/darsflow-pg
# Optional direct Neon connection used only by migration commands.
DATABASE_MIGRATION_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave both blank for safe non-sending development mode.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated registered emails explicitly allowed to access /platform.
PLATFORM_ADMIN_EMAILS=
